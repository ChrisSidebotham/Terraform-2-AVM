# ======================================================================
# Terraform import blocks generated by avmigrate.
#
# These AVM modules are built on AzAPI, so their state entry is an
# `azapi_resource`. `terraform state mv` cannot move an azurerm_* entry
# into one, so the existing Azure resource is imported instead.
#
# ---------------------------------------------------------------------
# PREFER THE AZURE STATE IMPORTER FOR ANYTHING NON-TRIVIAL
#
#   https://github.com/Azure/terraform-state-importer
#
# It queries Azure Resource Graph, runs `terraform plan` against your
# module, maps Azure resource IDs to the planned addresses and writes
# imports.tf for you - including for azapi_resource. That removes the
# error-prone part of the job below, which is finding and pasting the
# right resource ID for every address.
#
# A starter config has been generated: terraform-state-importer.config.yaml
#
#   terraform-state-importer run \
#     --config ./terraform-state-importer.config.yaml \
#     --terraformModulePath .
#
# It needs Azure CLI authentication and Resource Graph read access. Use
# the blocks below only if that is not available to you.
# ---------------------------------------------------------------------
#
#   Terraform does NOT load this file as written - the extension is
#   `.tf.disabled` on purpose, because the empty `id` values below would
#   fail `terraform validate`.
#
# HOW TO USE (manual fallback)
#   1. Fill in each `id` below with the resource's Azure resource ID. The
#      value is already in your current state:
#          terraform state show <old address>   # copy the `id` attribute
#   2. Rename this file to `avm-state-import.tf` so Terraform loads it.
#   3. The `removed` blocks stop Terraform tracking the old addresses
#      without destroying anything (Terraform 1.7+).
#   4. Run `terraform plan`. Imports are shown before anything changes.
#   5. Run `terraform apply` to record the imports, then plan again and
#      confirm it reports no changes.
#
#   Delete this file once the imports have been applied.
# ======================================================================

# azurerm_resource_group.platform  (avm-res-resources-resourcegroup)
#   azapi type: Microsoft.Resources/resourceGroups@2025-04-01
import {
  to = module.platform.azapi_resource.this[0]
  id = "" # TODO(avmigrate): <required> Azure resource ID of azurerm_resource_group.platform
}

# azurerm_storage_account.application  (avm-res-storage-storageaccount)
import {
  to = module.storage_account_application.azapi_resource.this[0]
  id = "" # TODO(avmigrate): <required> Azure resource ID of azurerm_storage_account.application
}

# azurerm_virtual_network.platform  (avm-res-network-virtualnetwork)
#   azapi type: Microsoft.Network/virtualNetworks@2024-07-01
import {
  to = module.virtual_network_platform.azapi_resource.vnet
  id = "" # TODO(avmigrate): <required> Azure resource ID of azurerm_virtual_network.platform
}

# ----------------------------------------------------------------------
# Stop tracking the old addresses without destroying the resources.
# Requires Terraform 1.7+. On older versions use, for each address:
#     terraform state rm '<old address>'
# ----------------------------------------------------------------------

removed {
  from = azurerm_resource_group.platform

  lifecycle {
    destroy = false
  }
}

removed {
  from = azurerm_storage_account.application

  lifecycle {
    destroy = false
  }
}

removed {
  from = azurerm_virtual_network.platform

  lifecycle {
    destroy = false
  }
}

